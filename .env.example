# Copy to .env and edit before production deploy
STOCKLY_ENV=production
STOCKLY_HOST=0.0.0.0
STOCKLY_PORT=5001
STOCKLY_WORKERS=2
STOCKLY_THREADS=4
STOCKLY_TIMEOUT=300

# REQUIRED in production — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
STOCKLY_SECRET_KEY=change-me-to-a-long-random-hex

# Behind HTTPS reverse proxy (nginx/caddy). Set 0 only for plain-HTTP LAN testing.
STOCKLY_COOKIE_SECURE=1
STOCKLY_COOKIE_SAMESITE=Lax
STOCKLY_TRUST_PROXY=1

STOCKLY_SESSION_DAYS=14
STOCKLY_DATA_DIR=/app/data

# First-boot admin (only used if DB is empty). Force-changed on first login.
STOCKLY_ADMIN_USER=admin
STOCKLY_ADMIN_PASS=admin123

# Residential/mobile proxy for scrapers. Grocery apps (Instamart, Zepto) block
# datacenter IPs, so on a cloud host their search returns 403 / login walls.
# Route scraper traffic through a residential proxy to look like a real user.
# Leave blank to connect directly (fine for local dev on a home connection).
STOCKLY_PROXY_SERVER=
STOCKLY_PROXY_USERNAME=
STOCKLY_PROXY_PASSWORD=

# ---------------------------------------------------------------------------
# Stock watcher (worker.py) — polls every active watch and WhatsApps you on
# any availability change. All free; no paid APIs required.
# ---------------------------------------------------------------------------
STOCKLY_WATCH_ENABLED=1
STOCKLY_WATCH_INTERVAL_MIN=20      # re-check each product every N minutes
STOCKLY_WATCH_TICK_SEC=60          # worker wake-up cadence
STOCKLY_WATCH_BATCH=40             # max checks per wake-up
STOCKLY_WATCH_PAUSE_SEC=1.5        # pause between checks (be polite)
STOCKLY_WATCH_NOTIFY_ON=change     # "change" | "availability" | "price_drop"
STOCKLY_WATCH_ERROR_ALERT_AFTER=0  # 0 = never alert on transient errors

# ---------------------------------------------------------------------------
# WhatsApp delivery.
#   provider = webjs (self-hosted, free, message anyone — scan QR once)
#            | callmebot (free personal alerts; bot is sometimes full)
#            | meta (WhatsApp Cloud API) | none (log only)
# ---------------------------------------------------------------------------
STOCKLY_WHATSAPP_PROVIDER=webjs
STOCKLY_WHATSAPP_TO=919876543210   # your number, international format, no +

# --- Self-hosted whatsapp-web.js bridge (provider=webjs) ---
# Run it with:  cd wa-bridge && npm install && npm start   (scan the QR once)
STOCKLY_WA_BRIDGE_URL=http://127.0.0.1:3001
STOCKLY_WA_BRIDGE_TOKEN=            # optional shared secret; set the same in wa-bridge

# CallMeBot (free)
STOCKLY_CALLMEBOT_PHONE=919876543210
STOCKLY_CALLMEBOT_APIKEY=

# Meta WhatsApp Cloud API (free tier; needs Meta app + approved template)
STOCKLY_META_TOKEN=
STOCKLY_META_PHONE_ID=
STOCKLY_META_API_VERSION=v21.0
STOCKLY_META_TEMPLATE=
STOCKLY_META_TEMPLATE_LANG=en

# ===========================================================================
# Execution model — queued checks (Redis + Dramatiq)
# ===========================================================================
# Scraping runs in dedicated worker containers, never inside gunicorn.
STOCKLY_REDIS_URL=redis://redis:6379/0

# Master switch. 0 reverts to the legacy in-gunicorn daemon-thread runner —
# the rollback path if the queue misbehaves. The API also falls back to it
# automatically whenever Redis is unreachable.
STOCKLY_QUEUE_ENABLED=1

# --- Per-platform concurrency -------------------------------------------
# Ceilings on simultaneous checks per platform, applied *per worker process*.
# The fleet-wide limit is this times the processes serving that platform's
# queue, capped by the worker's thread count — so raising one of these without
# the matching compose change (or the reverse) does nothing.
# 50 concurrent *users* must not mean 50 concurrent browsers; retailer rate
# limits bind long before CPU does, so raise these in steps and watch
# check_failures_total.
STOCKLY_CONCURRENCY_BLINKIT=6
# x2 worker-http processes = 4 concurrent checks.
STOCKLY_CONCURRENCY_BIGBASKET=2
STOCKLY_CONCURRENCY_ZEPTO=2
STOCKLY_CONCURRENCY_FLIPKART=2
STOCKLY_CONCURRENCY_JIOMART=2
# Parallelises without a second Chromium: the warm path is an HTTP call
# carrying the browser's cookies, not a page action.
STOCKLY_CONCURRENCY_INSTAMART=3
STOCKLY_CONCURRENCY_CROMA=1
STOCKLY_CONCURRENCY_APPLE=1

# How long to trust "this store serves that location" (stockly/stores.py).
# Store identity only — availability is never cached.
STOCKLY_STORE_CACHE_TTL_SEC=86400

# --- Fairness and safety limits -----------------------------------------
# Stops one huge search monopolising the workers ahead of a small one.
STOCKLY_MAX_INFLIGHT_CHECKS_PER_JOB=8
STOCKLY_MAX_ACTIVE_JOBS_PER_USER=2
STOCKLY_MAX_SEARCH_CHECKS=5000
STOCKLY_MAX_QUEUED_CHECKS_PER_USER=2000
STOCKLY_MAX_TOTAL_QUEUED_CHECKS=20000

# --- Timeouts and retries ------------------------------------------------
# A retailer must never permanently occupy a worker.
STOCKLY_HTTP_CHECK_TIMEOUT_SEC=15
STOCKLY_BROWSER_CHECK_TIMEOUT_SEC=40
STOCKLY_TASK_MAX_TIMEOUT_SEC=60
# Per-request ceiling on the direct-HTTP path. Raising it also widens the queue's
# time limit, since the limit is derived from the scraper's worst-case retry loop.
STOCKLY_HTTP_REQUEST_TIMEOUT_SEC=12
# Retries apply only to infrastructure failures, never to a real result.
STOCKLY_CHECK_MAX_RETRIES=2
STOCKLY_CHECK_RETRY_BASE_SEC=5

# --- Stale job recovery --------------------------------------------------
# A job whose workers died is failed rather than left polling forever.
STOCKLY_JOB_STALE_TIMEOUT_SEC=180
STOCKLY_RECOVERY_TICK_SEC=60

# --- Web tier ------------------------------------------------------------
STOCKLY_WORKERS=4
STOCKLY_THREADS=8
STOCKLY_MAX_REQUESTS=10000
# Structured JSON logs (defaults on in production).
STOCKLY_LOG_JSON=1
STOCKLY_LOG_LEVEL=info
